# Local development (docker compose exposes Postgres on host port 5433)
DATABASE_URL="postgresql://mansa:mansa@localhost:5433/mansa?schema=public&connection_limit=20"
# Used by `yarn test:e2e` - an isolated Postgres schema in the same database
TEST_DATABASE_URL="postgresql://mansa:mansa@localhost:5433/mansa?schema=test&connection_limit=20"

PORT=3000

# FX: "live" (public API with fallbacks) or "fixed" (built-in rate table only)
FX_PROVIDER=live
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
FX_CACHE_TTL_SECONDS=300
FX_FAILURE_BACKOFF_SECONDS=30
FX_REQUEST_TIMEOUT_MS=4000

# Seed two demo wallets on container start
SEED_ON_START=true
